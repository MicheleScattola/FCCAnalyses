#!/bin/bash

# Stop the script if any command fails
set -e 

echo ">>> 1. Generating file lists..."
python make_lists.py

echo ">>> 2. Running Templates (First 10 files)..."
# We limit threads to 4 to avoid the Memory crash (OOM) you saw earlier
fccanalysis run templatesMC.py \
    -f files_templates.txt \
    --output /afs/cern.ch/user/s/scattola/FCCAnalyses/Ztautau/treemaker/MC/templates/p8_ee_Ztautau_ecm91.root \
    --n-threads 4

echo ">>> 3. Running Data Analysis (Next 30 files)..."
fccanalysis run analysisMC.py \
    -f files_data.txt \
    --output /afs/cern.ch/user/s/scattola/FCCAnalyses/Ztautau/treemaker/MC/p8_ee_Ztautau_ecm91.root \
    --n-threads 4

echo ">>> DONE. All steps completed successfully."
